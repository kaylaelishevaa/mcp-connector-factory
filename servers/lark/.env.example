# --- Lark MCP Server — env template ---
# Copy to .env, fill values. .env is gitignored.

# --- Auth (the single bearer token the operator pastes in Claude app) ---
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 43-char URL-safe random string. Rotate quarterly.
LARK_MCP_TOKEN=

# --- Lark Bitable ---
LARK_APP_ID=cli_...
LARK_APP_SECRET=...
LARK_BASE_ID=...

# --- Server ---
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
LOG_ROOT=/data/logs

# --- Write tools kill switch ---
# Default ON. Set to false/0/no/off to make update_record + create_record
# refuse without touching Lark (maintenance window / panic mode). Read tools
# are unaffected. Flip + `docker compose up -d` to apply.
LARK_WRITE_ENABLED=true

# --- Cloudflare Tunnel (managed by separate cloudflared service) ---
# Named (remotely-managed) tunnel → stable URL https://lark-mcp.example.com.
# Create the tunnel + public hostname in Cloudflare Zero Trust → Tunnels,
# then paste its connector token here. (For an ephemeral quick tunnel instead,
# leave this blank and switch the cloudflared command in docker-compose.yml.)
CF_TUNNEL_TOKEN=
