# --- Acme Web MCP Server — env template ---
# Copy to .env, fill values. .env is gitignored. Keep real secrets in a secrets
# store, NOT committed (proposal §7).

# --- Inbound auth (the single bearer token Claude/the operator pastes in the app) ---
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotate quarterly. Separate from the outbound service-user creds below.
WEB_MCP_TOKEN=

# --- Outbound: NestJS admin API (example.com) ---
# Approach (i-b) login-and-refresh (chosen 2026-06-09). The connector logs in
# with these service-user creds and caches the 7d JWT, re-logging-in on expiry.
# The service user MUST be users.role='internal' with a non-`agent` RBAC role
# granting `view listing`. See 00_INVESTIGATION.md §1a/§1b.
#
# HOST: the backend is api.example.com (global prefix /api).
# admin.example.com is the Next.js admin FRONTEND, NOT the API — POSTing
# /api/auth/login there 405s/redirects to the login page (verified 2026-06-12).
WEB_API_BASE=https://api.example.com/api
WEB_SERVICE_EMAIL=
WEB_SERVICE_PASSWORD=

# --- Server ---
HOST=0.0.0.0
PORT=8081
LOG_LEVEL=INFO
LOG_ROOT=/data/logs

# --- Write tools: TWO independent kill switches ---
# Both default OFF (unlike the Lark connector). A write happens only when the
# relevant gate is one of {1,true,yes,on} AND the call passes dry_run=false (and,
# for destructive/identity ops, confirm=true). Dry-run previews work regardless.
#
#   WEB_WRITE_ENABLED          → LISTING writes (create/update/publish/sold/delete/bulk).
#   WEB_IDENTITY_WRITE_ENABLED → USER + ROLE/PERMISSION writes. This is the
#                                privilege-escalation surface — once the service
#                                account holds `super admin`, flipping this lets
#                                the inbound token create admins, mint roles, and
#                                reassign permissions site-wide. Deliberately
#                                separate so listing writes can be live while
#                                identity writes stay dark. Keep OFF until you
#                                specifically intend identity changes.
WEB_WRITE_ENABLED=false
WEB_IDENTITY_WRITE_ENABLED=false

# --- Write-tool forensics ---
# Pre-write backup snapshots (JSON, secrets redacted) land here, one file per
# executed mutation: <WEB_BACKUP_ROOT>/<tool>-<id>-<ts>.json. The append-only
# audit stream web_mcp_writes.jsonl lives under LOG_ROOT.
WEB_BACKUP_ROOT=/data/backups
# Seconds between items in a bulk listing op (each mutation fans out to portal-a
# + partner-portal portal sync — don't hammer). Default 1.0.
WEB_BULK_THROTTLE_S=1.0

# --- Cloudflare Tunnel (managed by separate cloudflared service) ---
# Named tunnel → stable URL e.g. https://web-mcp.example.com. Create the tunnel +
# public hostname (→ http://web-mcp:8081) in Cloudflare Zero Trust, paste its
# connector token here. Leave blank to use an ephemeral quick tunnel instead.
CF_TUNNEL_TOKEN=
